# Soundgraph environment — copy to .env and fill in your values.
# All variables are documented in the README.

DJANGO_SECRET_KEY=change-me
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=soundgraph
DB_USER=soundgraph
DB_PASSWORD=soundgraph
DB_HOST=localhost
DB_PORT=5432

LASTFM_API_KEY=

# Frontend UI language: es or en (Vite reads it from this root .env)
VITE_LANG=en

SOUNDGRAPH_NODE_LIMIT=50000
SOUNDGRAPH_MAX_CONCURRENT_SEARCHES=1
SOUNDGRAPH_MEMORY_LIMIT_MB=4096
SOUNDGRAPH_STALE_SEARCH_SECONDS=60
SOUNDGRAPH_LASTFM_RATE_PER_SECOND=3.8