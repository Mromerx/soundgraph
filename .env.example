# --- Soundgraph environment ---
# Copy this file to .env and fill in your values.

# Django
DJANGO_SECRET_KEY=change-me
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=soundgraph
DB_USER=soundgraph
DB_PASSWORD=soundgraph
DB_HOST=localhost
DB_PORT=5432

# External API keys (consumed by other processes)
DISCOGS_TOKEN=
LASTFM_API_KEY=