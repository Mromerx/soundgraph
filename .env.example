# --- Soundgraph environment ---
# Copy this file to .env and fill in your values.

# Django
DJANGO_SECRET_KEY=change-me
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=soundgraph
DB_USER=soundgraph
DB_PASSWORD=soundgraph
DB_HOST=localhost
DB_PORT=5432

# External API keys
LASTFM_API_KEY=

# --- Idioma de la interfaz del frontend ---
# es o en. Lo lee Vite (frontend/vite.config.js) desde el .env de la raíz.
VITE_LANG=es

# --- Límites de memoria y búsqueda (salvaguardas) ---
# Tope de artistas distintos que la búsqueda de conexión puede explorar en
# total (entre todas las semillas). Evita que el BFS explote con artistas muy
# populares. Según el presupuesto de RAM que quieras usar.
SOUNDGRAPH_NODE_LIMIT=50000
# Máximo de búsquedas de conexión corriendo en paralelo.
SOUNDGRAPH_MAX_CONCURRENT_SEARCHES=1
# Límite de RAM del proceso entero en MB (resource.setrlimit, POSIX). El
# programa nunca podrá superar este tope: cualquier exceso lanza MemoryError y
# la búsqueda termina con estado "failed" en vez de tirar el servidor.
SOUNDGRAPH_MEMORY_LIMIT_MB=4096
# Antigüedad (en segundos) a partir de la cual una búsqueda "pending/running"
# sin actividad se considera zombi y se expira con estado "failed". El BFS
# emite un heartbeat cada ~10s mientras trabaja, así que esto solo atrapa
# hilos muertos (ej. servidor reiniciado a mitad de corrida).
SOUNDGRAPH_STALE_SEARCH_SECONDS=60

# --- Throttle de la API de Last.fm ---
# Peticiones por segundo hacia Last.fm (límite del plan de tu API key, ej.
# 4/s). El intervalo entre llamadas se deriva de acá; el default (3.8) deja
# ~5% de margen sobre el tope para no provocar 429, que cuestan backoffs de
# 2-4s. Todos los flujos (coseno, grafo de puente, autocomplete) comparten
# este mismo limiter.
SOUNDGRAPH_LASTFM_RATE_PER_SECOND=3.8